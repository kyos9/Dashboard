# 이미지 안에서 다시 만들거나, 애초에 들어가면 안 되는 것들.
# 빼먹으면 빌드가 느려지는 정도가 아니라, 내 PC의 DB와 로그가 이미지에 딸려 간다.

.git
.gitignore

# 이미지 안에서 다시 설치·빌드한다
**/node_modules
**/__pycache__
*.pyc
backend/.venv
frontend/dist

# 내 PC의 데이터 — 절대 들어가면 안 된다
*.db
*.sqlite3
backend/logs
backend/backups
.env
.env.local

# 이미지와 무관한 것
*.bat
scripts/*.vbs
.vscode
.idea
.DS_Store
.coverage
htmlcov
