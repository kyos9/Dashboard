# 바깥에서 들어오는 문 — HTTPS를 끊어주고 앱으로 넘긴다.
#
# 앱을 그냥 공개된 포트에 열면 **비밀번호가 평문으로 오간다.** 카페 와이파이에서
# 한 번만 로그인해도 그대로 새어나간다. 그래서 앞에 이걸 둔다.
#
# 인증서는 Caddy가 알아서 받고 알아서 갱신한다 (Let's Encrypt). 사람이 90일마다
# 기억해서 해야 하는 일은 결국 잊어버리고, 그날 사이트가 죽는다.
#
# 받은 인증서는 caddy-data 볼륨에 남는다. 이 볼륨을 지우고 다시 올리면 인증서를
# 처음부터 다시 받는데, Let's Encrypt에는 발급 횟수 제한이 있다. 지우지 않는다.

{
	# 인증서에 문제가 생기면 여기로 알려준다. 비워둬도 동작한다.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# app 은 compose 안에서만 보이는 이름이다. 앱 자체는 바깥에 열려 있지 않다.
	reverse_proxy app:8000

	# Caddy가 X-Forwarded-Proto / X-Forwarded-For 를 붙여준다. 앱은 그 값을 보고
	# 쿠키에 Secure 를 붙일지, 그리고 로그인 시도를 누구로 셀지 정한다
	# (backend/app/routers/auth.py). 이 헤더를 지우면 둘 다 조용히 망가진다.
}
