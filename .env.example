# docker compose 로 띄울 때 쓰는 값. 복사해서 `.env` 로 두고 채운다.
#
#   cp .env.example .env
#
# `.env` 는 저장소에 올라가지 않는다 (.gitignore).

# Postgres 비밀번호. 아무거나가 아니라 길게 만들어 쓴다:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# 화면을 여는 비밀번호. **비워두면 잠기지 않는다** — 개인 PC에서는 그게 맞고,
# 공개된 주소에 올리는 순간 반드시 채운다. 안 채우면 아무나 진단 화면과 로그를 본다.
# 역시 직접 만들어 쓴다:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_PASSWORD=

# --- 바깥에 공개할 때만 (docker compose --profile https up -d) ---------------

# 이 화면을 띄울 도메인. 여기로 A 레코드가 서버를 가리키고 있어야 인증서를 받는다.
# 살 필요는 없다 — DuckDNS 같은 곳에서 무료로 받은 이름이면 된다 (DEPLOY.md 4번).
# 예: signal.example.com  또는  내이름.duckdns.org
DOMAIN=

# 인증서에 문제가 생기면 알려줄 주소. 비워둬도 동작한다.
ACME_EMAIL=

# --- 매크로 지표 (선택) ------------------------------------------------------

# FRED(세인트루이스 연준) API 키. https://fredaccount.stlouisfed.org/apikeys 에서
# 무료로 받는다.
#
# **비워둬도 매크로 지표는 나온다.** 키가 없으면 키가 필요 없는 CSV 경로로 받는다.
# 키가 있을 때 더해지는 것은 "그 값이 언제 발표됐나" 하나다 — CPI·PCE 는 발표 뒤에도
# 수정되기 때문에, 나중에 과거를 되짚을 때 이 날짜가 있으면 정확해진다.
FRED_API_KEY=

# --- 거의 안 건드리는 것 -----------------------------------------------------

# 받아쓸 이미지 태그. 비우면 latest(기본 브랜치의 최신)입니다.
# 새 이미지에 문제가 있을 때만 예전 커밋으로 고정합니다:
#   IMAGE_TAG=sha-1234abc
IMAGE_TAG=
