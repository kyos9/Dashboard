# docker compose 로 띄울 때 쓰는 값. 복사해서 `.env` 로 두고 채운다.
#
#   cp .env.example .env
#
# `.env` 는 저장소에 올라가지 않는다 (.gitignore).

# Postgres 비밀번호. 아무거나가 아니라 길게 만들어 쓴다:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# 화면을 여는 비밀번호. **비워두면 잠기지 않는다** — 개인 PC에서는 그게 맞고,
# 공개된 주소에 올리는 순간 반드시 채운다. 안 채우면 아무나 진단 화면과 로그를 본다.
# 역시 직접 만들어 쓴다:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_PASSWORD=

# --- 구글 로그인 (선택, DEPLOY.md 12번) ---------------------------------------
#
# 채우면 **비밀번호 문은 닫히고** 구글 계정으로만 들어온다. 계정마다 자기 종목·
# 포트폴리오가 따로 보인다. 비워두면 위 비밀번호 문 그대로다.
#
# 구글 클라우드 콘솔 → Google 인증 플랫폼 → 클라이언트 에서 받은 두 값.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 주인(지금까지 쓰던 데이터의 주인)의 구글 이메일. **필수다.** 이 계정으로 처음
# 로그인하면 새 계정을 만들지 않고 지금 데이터에 연결된다. 비워두면 로그인을 막는다
# — "처음 들어온 사람이 주인"은 공개 주소에서 위험한 기본값이다.
OWNER_GOOGLE_EMAIL=

# 승인 없이 바로 들어오는 사람들 (쉼표로 구분). 비워도 된다 — 그 밖의 사람은 구글로
# 들어오면 "승인 대기"가 되고, 관리자가 화면의 [사용자] 버튼에서 승인한다.
# 예: ALLOWED_GOOGLE_EMAILS=friend1@gmail.com,friend2@gmail.com
ALLOWED_GOOGLE_EMAILS=

# 사용자가 관리자에게 연락할 곳. 가입이 거절·차단된 사람의 화면과 "개인정보처리방침"
# 페이지(/privacy)에 그대로 보인다 — 공개해도 되는 것만 적는다 (문의용 메일, 오픈채팅 주소 등).
# 비우면 "관리자에게 문의"라고만 나온다. 로그인용 OWNER_GOOGLE_EMAIL 은 대신 보여주지 않는다.
OPERATOR_CONTACT=

# 거의 비워둔다. 로그인 후 "redirect_uri_mismatch" 가 나면 콘솔에 적은 주소의 앞부분을
# 그대로 적는다. 예: PUBLIC_URL=https://내이름.duckdns.org
PUBLIC_URL=

# --- 바깥에 공개할 때만 (docker compose --profile https up -d) ---------------

# 이 화면을 띄울 도메인. 여기로 A 레코드가 서버를 가리키고 있어야 인증서를 받는다.
# 살 필요는 없다 — DuckDNS 같은 곳에서 무료로 받은 이름이면 된다 (DEPLOY.md 4번).
# 예: signal.example.com  또는  내이름.duckdns.org
DOMAIN=

# 인증서에 문제가 생기면 알려줄 주소. 비워둬도 동작한다.
ACME_EMAIL=

# --- 매크로 지표 (선택) ------------------------------------------------------

# FRED(세인트루이스 연준) API 키. https://fredaccount.stlouisfed.org/apikeys 에서
# 무료로 받는다.
#
# **비워둬도 매크로 지표는 나온다.** 키가 없으면 키가 필요 없는 CSV 경로로 받는다.
# 키가 있을 때 더해지는 것은 "그 값이 언제 발표됐나" 하나다 — CPI·PCE 는 발표 뒤에도
# 수정되기 때문에, 나중에 과거를 되짚을 때 이 날짜가 있으면 정확해진다.
FRED_API_KEY=

# --- 재무 지표 (선택) --------------------------------------------------------

# OpenDART(금융감독원 전자공시) API 키. https://opendart.fss.or.kr 에서 가입 → 인증키
# 신청하면 무료로 바로 나온다. 한국 종목의 재무제표와 **공시일**을 여기서 받는다.
#
# 비워도 앱은 뜬다. 없으면 한국 종목도 야후로 받는데, 야후는 공시일을 안 줘서 "결산일 +
# 45일"로 추정한다. 미국 종목은 키 없이 SEC 에서 받는다 (위 OPERATOR_CONTACT 가 메일
# 주소면 SEC 에 연락처로 같이 보낸다 — SEC 가 요구하는 것이다).
#
# 넣은 뒤 `docker compose up -d` 로 다시 띄운다. 값은 어디에도 붙여넣지 않는다.
DART_API_KEY=

# --- 거의 안 건드리는 것 -----------------------------------------------------

# 받아쓸 이미지 태그. 비우면 latest(기본 브랜치의 최신)입니다.
# 새 이미지에 문제가 있을 때만 예전 커밋으로 고정합니다:
#   IMAGE_TAG=sha-1234abc
IMAGE_TAG=
